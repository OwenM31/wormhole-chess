{
  "name": "wormhole-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@react-spring/core": "^10.0.3",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "chess.js": "^1.4.0",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.181.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/verify-all-cards.ts",
    "typecheck:all": "tsc --noEmit && npx tsc -p functions/tsconfig.json --noEmit && npx tsc -p worker/tsconfig.json --noEmit",
    "build:all": "npm run build",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./d1/schema.sql",
    "db:migrate:prod": "wrangler d1 execute DB --remote --file=./d1/schema.sql",
    "deploy:worker": "cd worker && wrangler deploy",
    "deploy:pages": "wrangler pages deploy build --project-name=wormhole-chess --branch=master"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
